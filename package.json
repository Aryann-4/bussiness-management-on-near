{
  "name": "near-business-manager",
  "version": "1.0.0",
  "private": true,
  "description": "On-chain customers, products, invoices and NEAR payments for online businesses",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test:contract": "cargo test --manifest-path contracts/near-business/Cargo.toml --lib",
    "build:contract": "cargo build --manifest-path contracts/near-business/Cargo.toml --target wasm32-unknown-unknown --release",
    "install:frontend": "npm --prefix frontend install"
  }
}
